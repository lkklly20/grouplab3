import csv

countries = {}

try:
    # Opens the CSV file and reads it
    with open("country_full.csv") as file:
        file_reader = csv.DictReader(file)

        # Split the file into the required columns 
        for line in file_reader:
            country_name = line["name"]
            region_name = line["region"]
    
            region_name = region_name.strip()
    
            if region_name not in countries:
                countries[region_name] = []
        
        # Sorts through each country
            countries[region_name].append({
                'name': country_name.strip(),
                'region': region_name
            })

    # Write portion
    # Loop to retrieve both region name and country list 
    for region_name, country_list in countries.items():

        # Creates a new CSV file for each region
        with open(f"{region_name}.CSV", "w", newline="") as file:
            writer = csv.DictWriter(file, fieldnames=["name", "region"])

            # Write colummn headers
            writer.writeheader()
            writer.writerows(country_list)

# Checks for any outstanding errors
except FileNotFoundError:
    print("File not found")
except IOError:
    print("An I/O error occured")
except PermissionError:
    print("You don't have permission to access this file.")



